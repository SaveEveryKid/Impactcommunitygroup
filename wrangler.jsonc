{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Rename for the client's account if desired; keep the service binding below in sync.
  "name": "impactcommunitygroup",
  "main": "worker.ts",
  // Serve at <name>.<account>.workers.dev (works before a custom domain exists).
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "impactcommunitygroup" }],
  "triggers": { "crons": ["*/5 * * * *", "*/15 * * * *"] },
  "observability": { "enabled": true },
  // Non-secret configuration. Secrets (service role key, Stripe, Resend, CRON_SECRET)
  // are set with `wrangler secret` by the deploy workflow.
  "vars": {
    "NEXT_PUBLIC_APP_ENV": "production"
  }
}
