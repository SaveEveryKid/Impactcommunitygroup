{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Rename for the client's account if desired; keep the service binding below in sync.
  "name": "kindred-commons",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kindred-commons" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "kindred-commons-opennext-cache" }],
  "images": { "binding": "IMAGES" },
  "triggers": { "crons": ["*/5 * * * *", "*/15 * * * *"] },
  "observability": { "enabled": true },
  // Non-secret configuration. Secrets (service role key, Stripe, Resend, CRON_SECRET)
  // are set with `wrangler secret` by the deploy workflow.
  "vars": {
    "NEXT_PUBLIC_APP_ENV": "production"
  }
}
