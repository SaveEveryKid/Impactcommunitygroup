# ---------------------------------------------------------------------------
# Copy to .env.local for development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything
# else is server-only.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, emails, Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary working brand name (replace once the client finalizes identity)
NEXT_PUBLIC_BRAND_NAME="Kindred Commons"

# "production" | "demo" — demo shows a persistent banner and enables demo reset
NEXT_PUBLIC_APP_ENV=production

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard → Developers → API keys) ----------------------------
# Use test keys (sk_test_/pk_test_) until live payments are explicitly approved.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Must be "true" AND platform_settings.payments.live_enabled = true for live-mode keys to be accepted
STRIPE_ALLOW_LIVE=false

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Kindred Commons <notifications@example.org>"

# --- Cron / background jobs --------------------------------------------------
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# --- Testing -----------------------------------------------------------------
# Admin connection to a disposable Postgres server for DB security tests
TEST_DATABASE_ADMIN_URL=postgres://postgres@localhost:54322/postgres
